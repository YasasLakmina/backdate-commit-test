{
  "name": "m3-xai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "M3 XAI & Decision Support API: decision-prompt rules, PostgreSQL persistence and gateway to the Python ML service",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "db:init": "node --env-file-if-exists=.env scripts/initDb.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  }
}
